{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["lhr1"],
  "functions": {
    "api/v1.ts": {
      "includeFiles": "server/assets/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1?__path=:path*" },
    { "source": "/customer-support-assessment", "destination": "/assessment.html" },
    { "source": "/customer-support-assessment/:path*", "destination": "/assessment.html" },
    { "source": "/verify-certificate/:id", "destination": "/assessment.html" }
  ],
  "headers": [
    {
      "source": "/(customer-support-assessment|verify-certificate|assessment.html)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/handbook/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
