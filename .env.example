# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# --- Server only (never prefix with VITE_) --------------------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_…) or legacy service-role key. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Long random string (at least 32 bytes) used to hash tokens, recovery codes
# and IP addresses. Use the SAME value in every environment that shares a
# database, and never change it in production: existing sessions and
# recovery codes would stop working.
APP_SECRET=
# Public origin for Paystack callbacks and certificate links, no trailing
# slash. Leave unset on Preview: the deployment's own URL is used.
APP_BASE_URL=
# Paystack secret key: sk_test_… for testing, sk_live_… for production only.
# Card payment is switched off while this is empty.
PAYSTACK_SECRET_KEY=

# --- Browser (public by design) -------------------------------------------
# Used only by the admin sign-in page (Supabase Auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Tests only (never set on Vercel) -------------------------------------
# Points the server at a mock Paystack. Ignored when VERCEL_ENV=production.
# PAYSTACK_API_BASE=
# Lets scripts/local-api.ts accept x-test-client-ip, so each E2E candidate
# gets its own rate-limit bucket.
# LOCAL_API_TRUST_TEST_IP=
# API_PORT=8787
# CHROMIUM_PATH=
