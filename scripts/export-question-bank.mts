/**
 * Generates cpanel/csp-app/data/questionBank.php from server/questionBank.ts,
 * so the PHP API marks against exactly the same bank as the Vercel API.
 * The TypeScript file stays the single source: edit it, then run
 *
 *   npx tsx scripts/export-question-bank.mts
 *
 * The output lives in csp-app/, which is uploaded OUTSIDE public_html.
 */
import { writeFileSync, mkdirSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { CATEGORIES, OPTION_KEYS, QUESTION_BANK, QUESTION_BANK_VERSION } from '../server/questionBank.js';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const out = join(root, 'cpanel', 'csp-app', 'data', 'questionBank.php');

/** PHP single-quoted string literal. */
const str = (s: string) => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;

const lines: string[] = [
  '<?php',
  '// GENERATED by scripts/export-question-bank.mts from server/questionBank.ts. Do not edit.',
  '// SERVER-ONLY: contains the answer key. Must never be placed under public_html.',
  'declare(strict_types=1);',
  '',
  'return [',
  `    'version' => ${str(QUESTION_BANK_VERSION)},`,
  `    'optionKeys' => [${OPTION_KEYS.map(str).join(', ')}],`,
  "    'categories' => [",
];
for (const [key, c] of Object.entries(CATEGORIES)) {
  lines.push(`        ${str(key)} => ['label' => ${str(c.label)}, 'bankCount' => ${c.bankCount}, 'chapters' => [${c.chapters.join(', ')}]],`);
}
lines.push('    ],', "    'questions' => [");
for (const q of QUESTION_BANK) {
  lines.push(`        ${str(q.id)} => [`);
  lines.push(`            'id' => ${str(q.id)},`);
  lines.push(`            'category' => ${str(q.category)},`);
  lines.push(`            'prompt' => ${str(q.prompt)},`);
  lines.push(`            'options' => [${OPTION_KEYS.map((k) => `${str(k)} => ${str(q.options[k])}`).join(', ')}],`);
  lines.push(`            'correct' => ${str(q.correct)},`);
  lines.push('        ],');
}
lines.push('    ],', '];', '');

mkdirSync(dirname(out), { recursive: true });
writeFileSync(out, lines.join('\n'));
console.log(`Wrote ${QUESTION_BANK.length} questions (${QUESTION_BANK_VERSION}) to ${out}`);
