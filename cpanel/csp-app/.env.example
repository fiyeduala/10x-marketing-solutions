# Copy to .env in this folder (csp-app, outside public_html) and fill in.
# Never commit real values. Real environment variables, if your host sets
# any, take precedence over this file.

# --- Database (cPanel → MySQL Databases) -----------------------------------
DB_HOST=localhost
DB_PORT=3306
# cPanel prefixes names with your account, e.g. account_csp
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Application ------------------------------------------------------------
# Long random string (at least 32 bytes) used to hash tokens, recovery codes
# and IP addresses. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never change it once the site is live: existing sessions and recovery
# codes would stop working.
APP_SECRET=
# Public origin for Paystack callbacks and certificate links, no trailing
# slash, e.g. https://www.example.com
APP_BASE_URL=
# Paystack secret key: sk_test_… for testing, sk_live_… for production only.
# Card payment is switched off while this is empty.
PAYSTACK_SECRET_KEY=

# --- Optional -----------------------------------------------------------------
# Behind Cloudflare or another proxy, name the header carrying the visitor's
# address so rate limits are per visitor, e.g. CF-Connecting-IP
# CLIENT_IP_HEADER=

# --- Local development and tests only (never set on the live site) ----------
# APP_ENV=development
# Points the server at a mock Paystack. Ignored unless APP_ENV=development.
# PAYSTACK_API_BASE=
# Honours x-test-client-ip so each test candidate gets its own rate-limit
# bucket. Ignored unless APP_ENV=development.
# TRUST_TEST_IP=1
